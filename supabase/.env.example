# Ambiente da API Efí: use homologation nos testes e production no lançamento.
EFI_ENVIRONMENT=homologation
# Opcional: sobrescreve o host (sem https://), caso a Efí forneça outro endpoint.
# EFI_API_HOST=pix-h.api.efipay.com.br
# Use apenas como lista de nomes. Configure os valores com `supabase secrets set`.
EFI_CLIENT_ID=SEU_CLIENT_ID
EFI_CLIENT_SECRET=SEU_CLIENT_SECRET
EFI_CERTIFICATE_BASE64=SEU_CERTIFICADO_P12_EM_BASE64
EFI_PIX_KEY=CHAVE_PIX_CENTRAL_DA_PLATAFORMA
EFI_WEBHOOK_SECRET=SEGREDO_LONGO_ALEATORIO
WALLET_CRON_SECRET=OUTRO_SEGREDO_LONGO_ALEATORIO
